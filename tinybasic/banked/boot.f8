        PROCESSOR F8
        INCLUDE "VBCHARS.ASM"
        INCLUDE "runtime_equates.inc"
        ORG $1000
        DC $AA,$55,0
        INCLUDE "boot_title.inc"
        DI
        DCI RUNTIME
        XDC
        DCI $3D00
        LIS 2
        LR 2,A
        CLR
        LR 1,A
COPYRT  XDC
        LM
        XDC
        ST
        DS 1
        BNZ COPYRT
        DS 2
        BNZ COPYRT
        DCI $3F1C
        CLR
        ST
        ST
        DCI $3F22
        ST
        ST
        LI INIT_ID
        LR 0,A
        PI G_ENTRY
        LI SERIAL_INIT_ID
        LR 0,A
        PI G_ENTRY
        DCI BANNER
PRINT_BANNER
        LM
        CI 0
        BZ BANNER_DONE
        CI 13
        BZ BANNER_NEWLINE
        LR 1,A
        LI PUT_ID
        LR 0,A
        PI G_ENTRY
        BR PRINT_BANNER
BANNER_NEWLINE
        LI NEWLINE_ID
        LR 0,A
        PI G_ENTRY
        BR PRINT_BANNER
BANNER_DONE
        LI NEW_ID
        LR 0,A
        JMP G_JUMP
        INCLUDE "boot_ids.inc"
        INCLUDE "tape_ids.inc"
        INCLUDE "tape_core.f8"
        INCLUDE "common.inc"
        ORG $17FF
        DC $FF
        END
