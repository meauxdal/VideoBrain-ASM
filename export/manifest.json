{
 "name": "VideoBrain-ASM",
 "credit": "github.com/meauxdal/VideoBrain-ASM",
 "readme": [
  "Sources and disassemblies for the Umtech VideoBrain, laid out like Sean Riddle's",
  "listings (www.seanriddle.com/videobrain.html). Assemble with DASM: dasm file.asm -f3 -ofile.bin",
  "",
  "Every .asm file here was reassembled with DASM and reproduces its original binary byte",
  "for byte; the size and CRC32 of each are listed below. Include files are flattened, so",
  "each .asm is one complete assembly unit. Test results refer to the MiSTer VideoBrain core.",
  "",
  "annotated/ holds Sean Riddle's and Kurt Woloch's listings, unchanged except for added",
  "comments (see notes/asm-collection-annotations.txt). Original ROM images are not included."
 ],
 "prebuild": [
  ["python", "tinybasic/baseline/build.py", "--dasm", "{dasm}"],
  ["python", "tinybasic/timeshare/build_probe.py", "--dasm", "{dasm}"],
  ["python", "tinybasic/timeshare/build_probe.py", "--dasm", "{dasm}", "--console"],
  ["python", "tinybasic/banked/build.py", "--dasm", "{dasm}"]
 ],
 "items": [
  {"kind": "asm", "out": "disassemblies/infoman.asm", "title": "Information Manager - VB-1200 prototype, 9/25/78",
   "cwd": "infoman", "source": "infoman.asm"},

  {"kind": "copy", "out": "annotated/vbfinancier.asm", "source": "asm-collection/vbfinancier.asm"},
  {"kind": "copy", "out": "annotated/uvres-1n-2129-7802.asm", "source": "asm-collection/uvres-1n-2129-7802.asm"},
  {"kind": "copy", "out": "annotated/uvres-1n-2129-7802_rev1.asm", "source": "asm-collection/uvres-1n-2129-7802_rev1.asm"},
  {"kind": "copy", "out": "annotated/vbexp1.asm", "source": "asm-collection/vbexp1.asm"},
  {"kind": "copy", "out": "annotated/Money_Minder_vb1000mm.asm", "source": "asm-collection/Money_Minder_vb1000mm.asm"},
  {"kind": "copy", "out": "annotated/vbdemo.asm", "source": "asm-collection/vbdemo.asm"},
  {"kind": "copy", "out": "annotated/viceversa-en06.asm", "source": "asm-collection/viceversa-en06.asm"},
  {"kind": "copy", "out": "annotated/checkers-en04.asm", "source": "asm-collection/checkers-en04.asm"},

  {"kind": "asm", "out": "tennis/tennis-patent-court.asm", "title": "Tennis - EN03 with the patent court (US4232374)",
   "verb": "adapted by", "cwd": "tennis", "source": "tennis.asm", "includes": ["tennis"], "defines": ["PATENT_COURT=2"]},
  {"kind": "asm", "out": "tennis/tennis-candidate.asm", "title": "Tennis - patent game on stock hardware (work in progress)",
   "verb": "written by", "cwd": "tennis", "source": "candidate.asm", "includes": ["tennis"]},

  {"kind": "asm", "out": "diagnostics/dac_test.asm", "title": "DAC test", "verb": "written by",
   "cwd": "diagnostics/dac-test", "source": "dac_test.asm"},
  {"kind": "asm", "out": "diagnostics/selftest.asm", "title": "Self test", "verb": "written by",
   "cwd": "diagnostics/selftest", "source": "selftest.asm"},
  {"kind": "asm", "out": "diagnostics/selftest_int.asm", "title": "Self test with interrupts", "verb": "written by",
   "cwd": "diagnostics/selftest", "source": "selftest_int.asm"},
  {"kind": "asm", "out": "diagnostics/JoystickDiag.asm", "title": "Joystick diagnostic", "verb": "written by",
   "cwd": "diagnostics/joystick-diag", "source": "JoystickDiag.asm"},
  {"kind": "asm", "out": "diagnostics/TimingBaseline.asm", "title": "Timing baseline", "verb": "written by",
   "cwd": "diagnostics/timing", "source": "TimingBaseline.asm"},
  {"kind": "asm", "out": "diagnostics/TimingScreen.asm", "title": "Timing screen", "verb": "written by",
   "cwd": "diagnostics/timing", "source": "TimingScreen.asm"},

  {"kind": "asm", "out": "tinybasic/tinybasic-baseline.asm", "title": "Tiny BASIC - consolidated baseline, CRC32 F3BFF3D3",
   "verb": "modified by", "cwd": "tinybasic/baseline", "listing": "build/tinybasic/baseline/tinybasic.lst",
   "notes": ["Jerry D. Fox's Tiny BASIC as ported by Sean Riddle, with string-marker, empty-input",
             "backspace and cancelled-line fixes. Use a 4K RAM mapper ($3000-$3FFF)."]},

  {"kind": "asm", "out": "tinybasic-enhanced/bank0-boot.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 0, boot and tape",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/boot.lst",
   "notes": ["16 KB cartridge of eight 2 KB banks at $1000-$17FF: 0 boot, 1-4 interpreter,",
             "5 console, 6 keyboard, 7 dispatch. The banks join in that order to form the ROM."]},
  {"kind": "asm", "out": "tinybasic-enhanced/bank1-interpreter.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 1, interpreter",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/bank-1.lst"},
  {"kind": "asm", "out": "tinybasic-enhanced/bank2-interpreter.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 2, interpreter",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/bank-2.lst"},
  {"kind": "asm", "out": "tinybasic-enhanced/bank3-interpreter.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 3, interpreter",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/bank-3.lst"},
  {"kind": "asm", "out": "tinybasic-enhanced/bank4-interpreter.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 4, interpreter",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/bank-4.lst"},
  {"kind": "asm", "out": "tinybasic-enhanced/bank5-console.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 5, 24x15 console",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/console.lst"},
  {"kind": "asm", "out": "tinybasic-enhanced/bank6-keyboard.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 6, keyboard and serial",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/keyboard.lst"},
  {"kind": "asm", "out": "tinybasic-enhanced/bank7-dispatch.asm", "title": "Tiny BASIC Enhanced 2.0 - bank 7, dispatch and tape I/O",
   "verb": "written by", "cwd": "tinybasic/banked", "includes": ["build/tinybasic/banked", "tinybasic/banked", "tinybasic/baseline"],
   "listing": "build/tinybasic/banked/dispatch.lst"},

  {"kind": "asm", "out": "tinybasic-timeshare/display-probe.asm", "title": "Timeshare-style 24x15 display probe",
   "verb": "written by", "cwd": "tinybasic/timeshare", "includes": ["build/tinybasic/timeshare"],
   "listing": "build/tinybasic/timeshare/timeshare-display-probe.lst"},
  {"kind": "asm", "out": "tinybasic-timeshare/console-probe.asm", "title": "Timeshare-style 24x15 console probe (cursor and scrolling)",
   "verb": "written by", "cwd": "tinybasic/timeshare", "includes": ["build/tinybasic/timeshare"],
   "listing": "build/tinybasic/timeshare/timeshare-console-probe.lst"},

  {"kind": "asm", "out": "tinybasic-fixes/tinybasicvb-recordfix.asm", "title": "Tiny BASIC - record count fix, CRC32 D40A8E2B",
   "verb": "modified by", "cwd": "asm-collection/tinybasic_record_count_fix", "source": "tinybasicvb-recordfix.f8"},
  {"kind": "copy", "out": "tinybasic-fixes/tinybasic_recordfix_README.txt", "source": "asm-collection/tinybasic_record_count_fix/tinybasic_recordfix_README.txt"},
  {"kind": "copy", "out": "tinybasic-fixes/cancelfix_README.txt", "source": "asm-collection/tinybasic_record_count_fix/cancelfix_README.txt"},
  {"kind": "copy", "out": "tinybasic-fixes/inputfix_README.txt", "source": "asm-collection/tinybasic_record_count_fix/inputfix_README.txt"},
  {"kind": "copy", "out": "tinybasic-fixes/printfix_README.txt", "source": "asm-collection/tinybasic_record_count_fix/printfix_README.txt"},
  {"kind": "copy", "out": "tinybasic-fixes/stringfix_README.txt", "source": "asm-collection/tinybasic_record_count_fix/stringfix_README.txt"},
  {"kind": "copy", "out": "tinybasic-fixes/validation.txt", "source": "asm-collection/tinybasic_record_count_fix/validation.txt"},
